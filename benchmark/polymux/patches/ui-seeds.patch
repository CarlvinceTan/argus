+
+struct SeedFlash: View {
+    let id: String
+    @State private var show = false
+    var body: some View {
+        Color.clear.frame(width: 200, height: 160)
+            .overlay { if show { Text("Loading chat").padding(.top, 100) } }
+            .task(id: id) {
+                if CommandLine.arguments.contains("--seed-warning") {
+                    FileHandle.standardError.write(Data("Publishing changes from within view updates is not allowed\n".utf8))
+                }
+                guard CommandLine.arguments.contains("--seed-flash") else { return }
+                show = true
+                try? await Task.sleep(for: .milliseconds(350))
+                show = false
+            }
+    }
+}
